@model List<(string Name, int Count)>
@{
    ViewData["Title"] = "Grāmatu skaits katram autoram";
}

<h2>Grāmatu skaits katram autoram</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Autors</th>
            <th>Grāmatu skaits</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Name</td>
                <td>@x.Count</td>
            </tr>
        }
    </tbody>
</table>