@model List<praktiskais_uzdevums_3.Models.Book>

@if (Model.Count == 0)
{
    <p>Nekas nav atrasts.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nosaukums</th>
                <th>Gads</th>
                <th>Autors</th>
                <th>Žanrs</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Title</td>
                    <td>@b.Year</td>
                    <td>@b.Author.Name</td>
                    <td>@b.Genre.Title</td>
                </tr>
            }
        </tbody>
    </table>
}